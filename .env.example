# 推理后端切换:omlx | ollama(未设置默认 ollama)
LLM_BACKEND=omlx

# oMLX — Apple Silicon 推理服务器,OpenAI 兼容 API
# 文档:https://github.com/jundot/omlx
OMLX_HOST=http://127.0.0.1:8000
OMLX_API_KEY=               # 填 oMLX 的 sub key(用于 /v1/*;main key 是给管理面板的)
OMLX_EMBED_MODEL=bge-m3-mlx-fp16
OMLX_GEN_MODEL=qwen3.8-27b-4bit

# Ollama
OLLAMA_HOST=http://127.0.0.1:11434
EMBED_MODEL=bge-m3
GEN_MODEL=qwen3.8:27b-mlx

PORT=5173
